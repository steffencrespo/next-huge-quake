  "captions": [
    {
      "text": "Worldwide, from October first to",
      "start": 1,
      "end": 3.09
    },
    {
      "text": "twenty-fifth: one hundred twenty-one",
      "start": 3.09,
      "end": 5.365
    },
    {
      "text": "earthquakes above magnitude five.",
      "start": 5.365,
      "end": 7.78
    },
    {
      "text": "This is a historical record.",
      "start": 9.2,
      "end": 10.756
    },
    {
      "text": "Each red dot marks one epicenter.",
      "start": 11.139,
      "end": 13.705
    },
    {
      "text": "Watch them appear,",
      "start": 15.3,
      "end": 16.693
    },
    {
      "text": "day by day.",
      "start": 16.693,
      "end": 17.901
    },
    {
      "text": "The most active area was the Vanuatu",
      "start": 19.5,
      "end": 21.822
    },
    {
      "text": "region, with thirty-three earthquakes.",
      "start": 21.822,
      "end": 24.655
    },
    {
      "text": "Central America recorded thirteen.",
      "start": 26,
      "end": 28.554
    },
    {
      "text": "The Japan, Kuril and Kamchatka region",
      "start": 31,
      "end": 33.775
    },
    {
      "text": "had twelve.",
      "start": 33.775,
      "end": 34.808
    },
    {
      "text": "The Indonesia region had eleven.",
      "start": 36,
      "end": 38.322
    },
    {
      "text": "The China and Central Asia region",
      "start": 41,
      "end": 43.09
    },
    {
      "text": "had nine.",
      "start": 43.09,
      "end": 44.111
    },
    {
      "text": "And the Papua New Guinea region, eight.",
      "start": 46,
      "end": 48.74
    },
    {
      "text": "The remaining thirty-five were spread across",
      "start": 52,
      "end": 54.775
    },
    {
      "text": "the rest of the world.",
      "start": 54.775,
      "end": 56.18
    },
    {
      "text": "Most cluster along the boundaries of",
      "start": 59,
      "end": 60.904
    },
    {
      "text": "tectonic plates.",
      "start": 60.904,
      "end": 62.204
    },
    {
      "text": "The strongest was magnitude seven point",
      "start": 73,
      "end": 75.299
    },
    {
      "text": "seven, near Pitaloza Arriba,",
      "start": 75.299,
      "end": 77.307
    },
    {
      "text": "Panama, on October ninth.",
      "start": 77.307,
      "end": 79.734
    },
    {
      "text": "Next, magnitude seven point zero,",
      "start": 82,
      "end": 84.752
    },
    {
      "text": "near Nagqu, China,",
      "start": 84.752,
      "end": 86.017
    },
    {
      "text": "on October twenty-second.",
      "start": 86.017,
      "end": 87.759
    },
    {
      "text": "And magnitude six point nine,",
      "start": 91,
      "end": 93.252
    },
    {
      "text": "near Ozernovskiy, Russia,",
      "start": 93.252,
      "end": 94.936
    },
    {
      "text": "on October sixteenth.",
      "start": 94.936,
      "end": 96.619
    },
    {
      "text": "In all, eighteen earthquakes reached",
      "start": 100,
      "end": 102.45
    },
    {
      "text": "magnitude six or greater,",
      "start": 102.45,
      "end": 104.284
    },
    {
      "text": "and two reached seven.",
      "start": 104.284,
      "end": 105.944
    },
    {
      "text": "Historical records, from the",
      "start": 107,
      "end": 108.753
    },
    {
      "text": "U.S. Geological Survey.",
      "start": 108.753,
      "end": 110.808
    }
  ],
  "narrationStart": 1,
  "narrationEnd": 110.866,
