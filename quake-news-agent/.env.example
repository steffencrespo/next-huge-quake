# Docker Compose service name for development environment
DOCKER_SERVICE_NAME=quake-news-agent

# Configure if you plan to use Anthropic Models in your LLM prompts
ANTHROPIC_API_KEY=credential:anthropic.api_key

# Configure if you plan to use OpenAI in your LLM prompts
OPENAI_API_KEY=credential:openai.api_key

# --- Host port overrides (for running multiple dev stacks) ---
# Only the host-side port changes; inter-service traffic (e.g. worker -> Temporal
# at temporal:7233) is unaffected.
# OUTPUT_API_HOST_PORT=3001
# OUTPUT_TEMPORAL_UI_HOST_PORT=8080
# OUTPUT_TEMPORAL_HOST_PORT=7233

# --- API connection ---
# If OUTPUT_API_URL is set, it overrides OUTPUT_API_HOST_PORT.
# Use OUTPUT_API_URL for remote/staging servers; use OUTPUT_API_HOST_PORT for local port shifts.
# OUTPUT_API_URL=http://localhost:3001

# --- Project isolation ---
# Compose prefixes named volumes with the project name, so changing
# DOCKER_SERVICE_NAME creates fresh volumes and leaves the previous ones behind.
# Run `docker volume ls --filter name=<old-project-name>` to find orphaned
# volumes and `docker volume rm` to remove them.


# --- Video pipeline (quake_video) ---
# Location of the video/ package when the host worker does not run from quake-news-agent/ (default: the video/ folder next to quake-news-agent/)
# VIDEO_DIR=

# --- USGS monitor (quake_monitor) ---
# Dry run unless exactly "false": the monitor then records what it would start and starts nothing.
# MONITOR_DRY_RUN=true
# MONITOR_MAX_STARTS_PER_DAY=2        # real workflow starts per UTC day
# MONITOR_POLL_SECONDS=300            # minimum 30
# MONITOR_MIN_MAGNITUDE=5.5           # lowest magnitude requested from USGS
# MONITOR_STRONG_MAGNITUDE=6.0        # at or above: eligible on its own
# MONITOR_SIGNIFICANCE_FLOOR=600      # below strong: needs PAGER yellow or worse, or this USGS significance
# MONITOR_MIN_AGE_MINUTES=2
# MONITOR_MAX_AGE_HOURS=12
# MONITOR_BASELINE_GRACE_MINUTES=30   # first poll only: older events are never started
# MONITOR_STATE_DIR=                  # default: quake-news-agent/state/ (git-ignored)

# --- Narration length (read by the video CLIs that quake_video starts; set it in the worker's environment) ---
# Seconds kept after the narration before the video ends. Default 2.7; minimum 2 (the music fade-out); maximum 10.
# The narration audio limit is 35 - 1.5 - this value (30.8 s by default, 31.5 s at 2.0). Over-limit audio is kept
# as narration.rejected.mp3 and never regenerated automatically.
# NARRATION_END_MARGIN_SECONDS=2.7

# --- Breaking News Fast Track (quake_publish; off by default) ---
# Off unless exactly "true". Only monitor-started M6.0+ candidates (not PAGER red) are produced with the fast-track flag.
# FAST_TRACK_ENABLED=false
# "private" (default) stops at a verified private upload; only exactly "public" lets the policy publish.
# FAST_TRACK_FINAL_PRIVACY=private
# FAST_TRACK_MAX_PUBLISH_PER_DAY=1
# FAST_TRACK_MAX_AGE_HOURS=6           # older events go to a person
# FAST_TRACK_SEQUENCE_RADIUS_KM=150    # a published event this close ...
# FAST_TRACK_SEQUENCE_HOURS=72         # ... within this window makes it manual
# FAST_TRACK_DRIFT_MAGNITUDE=0.2       # revisions since production that make it manual
# FAST_TRACK_DRIFT_KM=25
# FAST_TRACK_PAUSE_FILE=               # default state/FAST_TRACK_PAUSED; while it exists nothing is fast-tracked or published
# FAST_TRACK_NOTIFY_URL=               # optional webhook; receives {"text": "..."} for every outcome
# Spending limits (USD) and provider prices. All required: while any is missing the fast track is unusable.
# Take prices from the providers' published price lists, and the input bound from a measured quake_news trace.
# FAST_TRACK_PER_EVENT_BUDGET_USD=
# FAST_TRACK_DAILY_BUDGET_USD=
# FAST_TRACK_MONTHLY_BUDGET_USD=
# FAST_TRACK_ANTHROPIC_INPUT_USD_PER_MTOK=
# FAST_TRACK_ANTHROPIC_OUTPUT_USD_PER_MTOK=
# FAST_TRACK_LLM_MAX_INPUT_TOKENS_PER_CALL=
# FAST_TRACK_ELEVENLABS_USD_PER_1K_CHARS=
# FAST_TRACK_MAX_NARRATION_CHARS=
